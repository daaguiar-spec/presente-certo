rules_version = '2';
// Regras de segurança do PresenteCerto.
// Cole este conteúdo em Firebase > Firestore Database > Regras e toque em Publicar.
// Troque o e-mail abaixo se o administrador for outra pessoa.
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() { return request.auth != null; }
    function admin() {
      return logado()
        && request.auth.token.email == 'daaguiar@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function dono(uid) { return logado() && request.auth.uid == uid; }

    // Fichas, seguidores, reservas, agradecimentos, amigo secreto, parabéns e nomes:
    // qualquer pessoa logada lê; cada um só escreve o próprio documento.
    match /profiles/{uid}       { allow read: if logado(); allow write: if dono(uid) || admin(); }
    match /follows/{uid}        { allow read: if logado(); allow write: if dono(uid) || admin(); }
    match /acoes/{uid}          { allow read: if logado(); allow write: if dono(uid) || admin(); }
    match /agradecimentos/{uid} { allow read: if logado(); allow write: if dono(uid) || admin(); }
    match /sorteios/{uid}       { allow read: if logado(); allow write: if dono(uid) || admin(); }
    match /parabens/{uid}       { allow read: if logado(); allow write: if dono(uid) || admin(); }
    match /usuarios/{uid}       { allow read: if logado(); allow write: if dono(uid); }

    // Nomes de usuário (@): cada @ pertence a uma só pessoa; ninguém toma o @ de outro
    match /usernames/{h} {
      allow read: if logado();
      allow create: if logado() && request.resource.data.uid == request.auth.uid && h.matches('^[a-z0-9._]{3,20}$');
      allow delete: if logado() && resource.data.uid == request.auth.uid;
    }

    // Códigos de ativação do Plus: só o administrador cria e lista; quem tem o código consegue usá-lo uma vez
    match /codigos/{c} {
      allow get: if logado();
      allow list, create, delete: if admin();
      allow update: if admin() || (logado()
        && resource.data.usadoPor == null
        && request.resource.data.usadoPor == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usadoPor','usadoEm']));
    }

    // Planos Plus: o administrador liga e desliga; a pessoa só ativa com um código válido usado por ela
    match /planos/{uid} {
      allow read: if logado();
      allow write: if admin() || (dono(uid)
        && request.resource.data.keys().hasOnly(['plus','ate','codigo'])
        && request.resource.data.plus == true
        && getAfter(/databases/$(database)/documents/codigos/$(request.resource.data.codigo)).data.usadoPor == request.auth.uid
        && request.resource.data.ate <= request.time + duration.value(getAfter(/databases/$(database)/documents/codigos/$(request.resource.data.codigo)).data.dias, 'd')
        && (resource == null || resource.data.codigo != request.resource.data.codigo));
    }

    // Assinaturas recebidas da Kiwify: gravadas só pelo servidor; só o administrador lê
    match /assinaturas/{e} { allow read: if admin(); allow write: if false; }

    // Sugestões dos usuários: qualquer pessoa logada envia; só o administrador lê, muda e apaga
    match /feedback/{id} {
      allow create: if logado()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','nome','email','tipo','texto','img','data','status'])
        && request.resource.data.status == 'nova'
        && request.resource.data.tipo in ['ideia','problema','elogio']
        && request.resource.data.texto is string && request.resource.data.texto.size() <= 1000
        && (!('img' in request.resource.data) || (request.resource.data.img is string && request.resource.data.img.size() < 400000));
      allow read, update, delete: if admin();
    }

    // Respostas do administrador às sugestões: só a própria pessoa lê; só o administrador escreve
    match /respostas/{uid} { allow read: if dono(uid) || admin(); allow write: if admin(); }

    // Listas de evento (casamento, chá de bebê, casa nova, chá de panela).
    // A pessoa cria e edita a sua lista, mas NÃO consegue publicá-la sozinha: quem publica é o servidor (api/publicar-evento),
    // depois de conferir o pagamento. Convidados (logados) só leem listas publicadas.
    match /eventos/{id} {
      allow read: if admin() || (logado() && (resource.data.dono == request.auth.uid || resource.data.publicado == true));
      allow create: if logado()
        && request.resource.data.dono == request.auth.uid
        && request.resource.data.publicado == false
        && request.resource.data.tipo in ['casamento','chabebe','casanova','panela']
        && request.resource.data.keys().hasOnly(['dono','donoNome','tipo','titulo','data','msg','itens','publicado','criado'])
        && request.resource.data.itens.size() <= 80;
      allow update: if logado() && resource.data.dono == request.auth.uid
        && request.resource.data.dono == resource.data.dono
        && request.resource.data.publicado == resource.data.publicado
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['donoNome','tipo','titulo','data','msg','itens'])
        && request.resource.data.tipo in ['casamento','chabebe','casanova','panela']
        && request.resource.data.itens.size() <= 80;
      allow delete: if logado() && resource.data.dono == request.auth.uid;

      // Presentes já escolhidos pelos convidados (todos veem "escolhido", ninguém vê por quem)
      match /marcados/{item} {
        allow read: if logado();
        allow create: if logado()
          && get(/databases/$(database)/documents/eventos/$(id)).data.publicado == true
          && get(/databases/$(database)/documents/eventos/$(id)).data.dono != request.auth.uid
          && getAfter(/databases/$(database)/documents/eventos/$(id)/quem/$(item)).data.por == request.auth.uid;
        allow delete: if logado() && get(/databases/$(database)/documents/eventos/$(id)/quem/$(item)).data.por == request.auth.uid;
      }
      // Quem escolheu cada presente: só a própria pessoa (e o administrador) enxerga
      match /quem/{item} {
        allow read: if admin() || (logado() && resource.data.por == request.auth.uid);
        allow create: if logado() && request.resource.data.por == request.auth.uid
          && get(/databases/$(database)/documents/eventos/$(id)).data.publicado == true;
        allow delete: if logado() && resource.data.por == request.auth.uid;
      }
    }

    // Créditos de lista de evento (1 por compra de R$ 9,90): gravados só pelo servidor ou pelo administrador
    match /creditos/{e} {
      allow read: if admin() || (logado() && request.auth.token.email_verified == true && request.auth.token.email.lower() == e);
      allow write: if admin();
    }

    // Fotos dos itens das listas
    match /fotos/{uid}/itens/{item} { allow read: if logado(); allow write: if dono(uid) || admin(); }

    // Configuração (afiliados, anúncios, avisos, moderação): todos leem, só o administrador muda
    match /config/{doc} { allow read: if logado(); allow write: if admin(); }

    // Contadores de cliques: cada um grava o seu; só o administrador vê todos
    match /metricas/{uid} { allow read: if dono(uid) || admin(); allow write: if dono(uid); }

    // Dados privados de cada pessoa (grupos)
    match /data/users/{uid}/{doc=**} { allow read, write: if dono(uid); }
  }
}
